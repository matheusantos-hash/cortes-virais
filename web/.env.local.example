# Project Settings > API > Project URL (sem barra no final e sem /rest/v1)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# Chave "anon" / "publishable" (NUNCA a service_role / secret)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cadastro público de novas contas. Deixe false enquanto não houver créditos/pagamento.
NEXT_PUBLIC_ALLOW_SIGNUP=false

# Limite de tamanho do upload mostrado no site (em MB).
# Plano gratuito do Supabase: 50. Depois de aumentar o limite em Storage > Settings (plano Pro), suba este valor.
NEXT_PUBLIC_MAX_UPLOAD_MB=50
