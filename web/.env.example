# Configuração do Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Chave secreta de serviço (Project Settings > API > service_role / secret key)
# OBRIGATÓRIA no servidor para permitir exclusão de clipes, limpeza do Storage e ações de admin
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Opcionais
NEXT_PUBLIC_ALLOW_SIGNUP=false
NEXT_PUBLIC_MAX_UPLOAD_MB=51200
